generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  DUPLEX
  SITE
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  SALE_AGREED
  SOLD
  LET_AGREED
}

enum TourType {
  PANORAMA
  MATTERPORT
  VIDEO
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
}

model Property {
  id           String         @id @default(cuid())
  reference    String         @unique
  slug         String         @unique
  status       PropertyStatus @default(DRAFT)
  listingType  ListingType    @default(SALE)
  propertyType PropertyType   @default(HOUSE)

  // Public, customer-facing content (bilingual)
  titleEn     String
  titleEs     String
  summaryEn   String @default("")
  summaryEs   String @default("")
  descriptionEn String @default("")
  descriptionEs String @default("")

  addressLine String
  town        String
  county      String
  eircode     String @default("")

  price       Int // euros — sale price or monthly rent
  rentPeriod  String @default("month")

  bedrooms    Int    @default(0)
  bathrooms   Int    @default(0)
  floorArea   Int    @default(0) // square metres
  berRating   String @default("")
  berNumber   String @default("")
  yearBuilt   Int?
  heating     String @default("")
  furnished   Boolean @default(false)
  featuresEn  String[] @default([])
  featuresEs  String[] @default([])

  lat         Float?
  lng         Float?
  featured    Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    PropertyImage[]
  tours     PropertyTour[]
  private   PropertyPrivate?
  enquiries Enquiry[]

  @@index([status, publishedAt])
  @@index([county])
  @@index([listingType])
}

/// Staff-only information. Never included in public queries.
model PropertyPrivate {
  id             String   @id @default(cuid())
  propertyId     String   @unique
  vendorName     String   @default("")
  vendorPhone    String   @default("")
  vendorEmail    String   @default("")
  guidePrice     Int?
  commissionRate Float?
  exclusiveUntil DateTime?
  keysLocation   String   @default("")
  alarmCode      String   @default("")
  accessNotes    String   @default("")
  solicitor      String   @default("")
  legalStatus    String   @default("")
  internalNotes  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String
  url        String
  altEn      String @default("")
  altEs      String @default("")
  sortOrder  Int    @default(0)
  isCover    Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model PropertyTour {
  id         String   @id @default(cuid())
  propertyId String
  type       TourType @default(PANORAMA)
  titleEn    String   @default("")
  titleEs    String   @default("")
  url        String
  sortOrder  Int      @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Enquiry {
  id           String        @id @default(cuid())
  propertyId   String?
  name         String
  email        String
  phone        String @default("")
  message      String
  locale       String @default("en")
  status       EnquiryStatus @default(NEW)
  internalNote String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model CompanySettings {
  id          Int      @id @default(1)
  name        String
  taglineEn   String @default("")
  taglineEs   String @default("")
  aboutEn     String @default("")
  aboutEs     String @default("")
  phone       String @default("")
  email       String @default("")
  address     String @default("")
  psra        String @default("")
  openingHours String @default("")
  heroImageUrl String @default("")
  updatedAt   DateTime @updatedAt
}
